# Salin file ini jadi ".env" lalu isi nilainya

# Didapat dari provider database (Railway/Render/Supabase akan kasih otomatis)
DATABASE_URL="postgresql://user:password@host:5432/bms_db?schema=public"

# Ganti dengan string acak panjang, jangan pakai contoh ini di production
JWT_SECRET="ganti_dengan_string_acak_yang_panjang_dan_rahasia"

# Umur token login, "8h" = 8 jam
JWT_EXPIRES_IN="8h"

# Port server (Railway/Render biasanya override otomatis lewat env PORT)
PORT=4000

# Domain frontend yang diizinkan akses API (untuk CORS), pisahkan dengan koma kalau lebih dari satu
FRONTEND_ORIGIN="http://localhost:5173"

# --- Upload dokumen (STNK/KIR/Invoice/SIA/dst) ke Google Drive ---
# Pakai OAuth2 (akun Gmail kamu sendiri), BUKAN Service Account -- karena
# Service Account tidak punya kuota penyimpanan di Gmail biasa (non-Workspace).
# Lihat panduan setup lengkap di backend/src/services/googleDrive.js
# 1) Buat OAuth client "Desktop app" di Google Cloud Console > Credentials
# 2) Jalankan sekali: node backend/scripts/getGoogleRefreshToken.js
#    untuk dapetin GOOGLE_OAUTH_REFRESH_TOKEN
GOOGLE_OAUTH_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="xxxxx"
GOOGLE_OAUTH_REFRESH_TOKEN="xxxxx"
GOOGLE_DRIVE_DOKUMEN_FOLDER_ID="isi_dengan_id_folder_drive_tujuan"
