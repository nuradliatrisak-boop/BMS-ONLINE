// Skema database untuk Sistem BMS - PT Bintang Muara Sejati
// Menggantikan objek `DB` yang dulu disimpan di window.storage (browser only)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN   // akses semua divisi & pengaturan
  STAFF   // akses terbatas ke divisi miliknya
}

enum StatusPembayaran {
  BELUM
  SEBAGIAN
  LUNAS
}

enum StatusTTD {
  BELUM_TTD
  LENGKAP
}

enum TipeTransaksi {
  PENJUALAN
  PENGELUARAN
}

enum TipeSolar {
  MASUK
  KELUAR
}

// Status realisasi baris Jadwal Setor Solar (checklist harian):
// BELUM   = belum dicentang/direalisasi sama sekali
// SESUAI  = disetor pas sama literWajib (tinggal dicentang, tanpa ketik apa-apa)
// SELISIH = disetor beda dari literWajib (kurang ATAU lebih -- tandanya
//           dilihat dari literSetor vs literWajib, bukan dari enum ini)
enum StatusSetor {
  BELUM
  SESUAI
  SELISIH
}

// Jenis aset yang punya dokumen kelengkapan (STNK/KIR, akte kapal, dst).
enum AsetTipe {
  MOBIL
  KAPAL
  ALAT_BERAT
}

// Tipe sopir, dipakai untuk menentukan aturan komisi:
// TRONTON     = komisi flat (default 50.000, bisa ditimpa situasional per SJ)
// COLD_DIESEL = komisi diinput manual tiap kali (kadang diambil per hari)
enum TipeSopir {
  TRONTON
  COLD_DIESEL
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // hash bcrypt
  nama      String
  role      Role     @default(STAFF)
  divisi    String?  // null kalau ADMIN (semua divisi)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  alamat    String?
  telepon   String?
  npwp      String?
  divisi    String
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())

  invoices  Invoice[]
  prices    CustomerPrice[]
  rekapPenjualan RekapPenjualan[]
  suratJalan SuratJalan[]
  tensiv    Tensiv[]
  recipients CustomerRecipient[]
}

// Daftar "Penerima" pengiriman milik seorang Customer, beserta alamat
// tujuannya masing-masing (kolom "Penerima" & "Tujuan" pada Surat Jalan
// fisik). Dipakai terutama untuk customer distributor yang mengirim ke
// banyak PT/CV berbeda (mis. BP. Alexander -> PT. Pitaco Mitra Perkasa,
// PT. Alko Putra Mahkota, dst) supaya tidak digabung jadi satu alamat
// yang sangat panjang. Untuk customer biasa cukup 1 penerima = nama &
// alamat customer itu sendiri. Data ini bisa ditambah/diedit/dihapus
// bebas lewat menu Customer (kolom Edit).
model CustomerRecipient {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  nama       String   // Nama penerima, mis. "PT. Pitaco Mitra Perkasa"
  alamat     String   // Alamat/tujuan pengiriman penerima ini
  telepon    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Master kode jenis barang/stock (AA = Pasir Putih, BB = Batu Split, dst).
// Dipakai sebagai daftar pilihan (dropdown) saat mengisi harga customer,
// supaya kode tidak diketik manual dan tidak typo/dobel.
model StockMaster {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CustomerPrice {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  destinationCode String
  vehicleType     String   @default("CD") // CD / TRONTON
  stockCode       String
  stockName       String
  hargaM3         Float    @default(0)
  sewaTruk        Float    @default(0)
  hppTruk         Float    @default(0)
  destination     String?
  discount        String?
  createdAt       DateTime @default(now())

  @@unique([customerId, destinationCode, vehicleType, stockCode])
}

model RekapPenjualan {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tanggal       DateTime
  noSuratJalan  String
  noPolisi      String
  jenisBarang   String
  panjang       Float    @default(0)
  lebar         Float    @default(0)
  tinggi        Float    @default(0)
  jumlah        Float    @default(0)
  harga         Float    @default(0)
  total         Float    @default(0)
  catatan       String?
  createdAt     DateTime @default(now())

  @@index([customerId, tanggal])
  @@index([noSuratJalan])
}

model Armada {
  id        String   @id @default(cuid())
  nopol     String
  jenis     String
  sopir     String?  // nama sopir -- disalin otomatis dari Sopir.nama kalau sopirId diisi,
                      // tetap ada untuk kendaraan lama yang belum dikaitkan ke master Sopir.
  sopirId   String?  // opsional: kaitan ke master Sopir (menu "Sopir")
  sopirRef  Sopir?   @relation(fields: [sopirId], references: [id])
  divisi    String
  // Index P-L-T & Volume (sheet "INDEK MOBIL" di Excel) -- ukuran bak kendaraan,
  // dipakai sebagai acuan/patokan volume muatan (m3) per kendaraan.
  panjang   Float?   // meter
  lebar     Float?   // meter
  tinggi    Float?   // meter
  volume    Float?   // m3, biasanya panjang x lebar x tinggi tapi bisa ditimpa manual
  createdAt DateTime @default(now())

  suratJalan SuratJalan[]
  // Kelengkapan dokumen kendaraan (STNK, KIR, foto mobil, dst) dicari lewat
  // model Dokumen dengan asetTipe="MOBIL" & asetId=Armada.id (relasi bebas,
  // TIDAK pakai foreign key Prisma -- lihat catatan di model Dokumen).

  @@index([sopirId])
}

// Master data Sopir -- menu tersendiri, TERPISAH dari Armada (kendaraan)
// karena sopir bisa pindah-pindah kendaraan dan komisinya melekat ke
// ORANGnya, bukan ke platnya. `komisiDefault` cuma acuan/auto-isi:
//   - Tronton      : biasanya flat 50.000, tapi tetap bisa situasional
//                    (nilai aktual per pengiriman disimpan di SuratJalan.uangKomisi,
//                    auto keisi dari sini lalu boleh diubah manual).
//   - Cold Diesel  : komisinya manual tiap kali (kadang diambil per hari),
//                    jadi komisiDefault dibiarkan 0 -- staf isi manual di SJ.
model Sopir {
  id            String    @id @default(cuid())
  nama          String
  tipe          TipeSopir
  noHp          String?
  komisiDefault Float     @default(0)
  aktif         Boolean   @default(true)
  keterangan    String?
  createdAt     DateTime  @default(now())

  armada        Armada[]
  suratJalan    SuratJalan[]

  @@index([tipe])
}

// Rate "uang makan" alat berat -- kombinasi unit (PC 75, PC 200, dst) +
// kategori pemakaian (Bucket/Breker/Longarm/Diatas Air/dst) menentukan
// nominal uang makan operator, dipakai auto-isi saat baris invoice sewa
// alat berat dibuat (lihat InvoiceItem.uangMakan), tetap bisa ditimpa
// manual per baris kalau situasinya beda.
model UangMakanAlat {
  id           String   @id @default(cuid())
  unitAlat     String
  kategoriAlat String
  nominal      Float    @default(0)
  createdAt    DateTime @default(now())

  @@unique([unitAlat, kategoriAlat])
}

// Master data Kapal (Divisi Kapal) -- terpisah dari Armada karena field &
// dokumen kelengkapannya beda total (Gross Akte, Sertifikat Keselamatan,
// Pas Besar, Buku Pulau, dst, bukan STNK/KIR). Dipakai untuk halaman
// "Kapal" (kelola data + dokumen kelengkapan tiap kapal).
model Kapal {
  id        String   @id @default(cuid())
  nama      String
  noLambung String?  // opsional, identitas fisik kapal kalau ada
  divisi    String   @default("Kapal")
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  // Dokumen kelengkapan (Gross Akte, dst) dicari lewat model Dokumen
  // dengan asetTipe="KAPAL" & asetId=Kapal.id.
}

// Master data unit Alat Berat/Excavator -- terpisah dari kategori
// "Alat Berat" di DivisiTx (yang cuma nama bebas untuk pencatatan
// keuangan). Model ini khusus menyimpan data unit + dokumen
// kelengkapannya (Surat Pelepasan Hak, Invoice, SIA, SIO, foto unit).
model AlatBeratUnit {
  id        String   @id @default(cuid())
  nama      String
  jenis     String?  // Excavator, Bulldozer, dst
  divisi    String   @default("Alat Berat")
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  // Dokumen kelengkapan (Invoice, SIA, SIO, dst) dicari lewat model Dokumen
  // dengan asetTipe="ALAT_BERAT" & asetId=AlatBeratUnit.id.
}

// Dokumen kelengkapan aset (Mobil/Kapal/Alat Berat) -- satu tabel serba-guna
// dipakai lintas menu supaya tidak perlu bikin tabel Dokumen terpisah per
// jenis aset. `asetId` SENGAJA tidak dibuatkan foreign key Prisma (relasi
// polimorfik: bisa nunjuk ke Armada.id / Kapal.id / AlatBeratUnit.id
// tergantung `asetTipe`, dan Prisma/Postgres tidak bisa 1 kolom FK ke 3
// tabel berbeda) -- integritasnya dijaga di kode routes (hapus dokumen ikut
// saat aset induknya dihapus, lihat routes kapal.js/alatBeratUnit.js/armada.js).
// Baris "wajib" (STNK, KIR, Gross Akte, SIA, dst) otomatis dibuat kosong
// saat aset baru ditambahkan, lalu tinggal diisi/upload belakangan. User
// juga bebas menambah baris dokumen "opsional" sendiri (label bebas), baik
// yang perlu upload file maupun yang cukup diisi teks (mis. nomor
// dokumen/tanggal berlaku) lewat kolom `nilai`.
model Dokumen {
  id            String    @id @default(cuid())
  asetTipe      AsetTipe
  asetId        String
  label         String    // "STNK", "KIR", "Foto Mobil", "Gross Akte", dst -- atau label custom
  file          String?   // LEGACY: nama file di /uploads/dokumen (upload lama sebelum pindah ke Drive)
  fileNama      String?   // nama file asli saat diupload (dipakai baik utk file lokal lama maupun Drive)
  driveFileId   String?   // ID file di Google Drive (dipakai buat hapus/ganti file)
  driveViewUrl  String?   // link Google Drive buat lihat/download filenya -- upload BARU disimpan ke sini,
                           // bukan lagi ke disk lokal (disk hosting gratisan sifatnya sementara)
  nilai         String?   // isian teks/angka untuk kolom opsional yang bukan file
  berlakuSampai DateTime? // opsional, tanggal kadaluarsa dokumen (STNK/KIR/dll)
  catatan       String?
  wajib         Boolean   @default(false) // true = baris bawaan (default), false = ditambah manual/custom
  butuhFile     Boolean   @default(true)  // false = baris ini cukup diisi teks (kolom `nilai`),
                                           // TIDAK butuh upload file -- form & panel tidak akan
                                           // menampilkan input upload untuk baris ini
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([asetTipe, asetId])
}

model Material {
  id        String   @id @default(cuid())
  kode      String?  @unique
  nama      String
  satuan    String
  hargaSatuan Float  @default(0)
  divisi    String
  createdAt DateTime @default(now())
}

model Invoice {
  id          String   @id @default(cuid())
  no          String   @unique
  divisi      String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  tanggal     DateTime
  jatuhTempo  DateTime?
  halaman     Int      @default(1)
  status      StatusPembayaran @default(BELUM)
  catatan     String?
  createdAt   DateTime @default(now())

  items       InvoiceItem[]
  pembayaran  Pembayaran[]
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  suratJalanId String?  @unique
  suratJalan   SuratJalan? @relation(fields: [suratJalanId], references: [id])
  // Baris SEWA ALAT BERAT boleh ditarik dari satu rekaman Tensiv (Daftar Kerja
  // Harian alat, lihat model Tensiv di bawah) -- sama pola dengan suratJalanId
  // di atas: 1 Tensiv cuma boleh dipakai di 1 baris invoice.
  tensivId     String?  @unique
  tensiv       Tensiv?  @relation(fields: [tensivId], references: [id])
  keterangan   String
  qty          Float
  satuan       String?
  hargaSatuan  Float
  // --- khusus penagihan SEWA ALAT BERAT (opsional, boleh null untuk
  // invoice material/armada biasa) ---
  kategoriAlat String?   // "Bucket" / "Breker" / "Mobilisasi" -> dipakai statistik per kategori alat
  unitAlat     String?   // nama unit alatnya, mis. "PC 200", "SANY PC - 075", "Longarm"
  tglPakai     DateTime? // tanggal pemakaian alat pada baris ini (bukan tanggal invoice)
  // --- lokasi sewa (opsional), dipakai statistik/filter per lokasi & peta ---
  lokasi       String?   // nama lokasi bebas, diketik staf mis. "Cimanggis 2", "Kp. Rambutan"
  lokasiLat    Float?    // hasil geocoding otomatis dari `lokasi` (lihat services/geocode.js)
  lokasiLng    Float?    // null kalau lokasi belum ada/gagal digeocode -- tidak wajib diisi
  // --- Biaya (opsional), dipotong dari qty*hargaSatuan buat hitung "Net"
  // INTERNAL (tidak ikut dicetak ke customer -- lihat services/invoiceXlsx.js
  // & print.js yang sengaja TIDAK menyentuh field ini). Baris armada/material:
  // belanjaPasir/uangMobil/uangJalan/uangKomisi disalin otomatis dari
  // SuratJalan terkait saat baris dibuat (boleh ditimpa manual). Baris sewa
  // alat berat: uangMakan disalin otomatis dari UangMakanAlat berdasarkan
  // kategoriAlat+unitAlat baris ini (boleh ditimpa manual). ---
  belanjaPasir Float?
  uangMobil    Float?
  uangJalan    Float?
  uangKomisi   Float?
  uangMakan    Float?

  @@index([kategoriAlat])
  @@index([unitAlat])
  @@index([lokasi])
}

model Pembayaran {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tanggal    DateTime
  nominal    Float
  metode     String?
  catatan    String?
}

model SuratJalan {
  id          String   @id @default(cuid())
  no          String   @unique
  divisi      String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  armadaId    String?
  armada      Armada?  @relation(fields: [armadaId], references: [id])
  tujuan      String
  penerima    String?  // Nama penerima (bisa dari master CustomerRecipient, atau diketik/edit manual)
  jenisBarang String?
  noPolisi    String?
  sopir       String?
  sopirId     String?  // opsional: kaitan ke master Sopir -- kalau diisi, `sopir` (teks)
                        // otomatis disalin dari Sopir.nama, dan uangKomisi otomatis
                        // disarankan dari Sopir.komisiDefault (masih bisa ditimpa manual).
  sopirRef    Sopir?   @relation(fields: [sopirId], references: [id])
  panjang     Float    @default(0)
  lebar       Float    @default(0)
  tinggi      Float    @default(0)
  m3          Float    @default(0)
  jam         String?
  tanggal     DateTime
  statusTTD   StatusTTD @default(BELUM_TTD)
  isDraft     Boolean  @default(false)
  detail      Json?    // daftar barang / muatan (fleksibel, mirror bentuk lama)
  // --- Biaya operasional pengiriman ini (opsional, per permintaan direktur):
  // dipotong dari harga jual supaya invoice bisa nampilin nilai "Net" internal
  // (harga jual dikurangi 4 pos ini) tanpa mengubah harga yang dicetak ke
  // customer. Semua auto 0, diisi manual staf per SJ -- belanjaPasir & uangMobil
  // & uangJalan dianggap pos yang beda-beda walau namanya mirip. ---
  belanjaPasir Float   @default(0)
  uangMobil    Float   @default(0)
  uangJalan    Float   @default(0)
  uangKomisi   Float   @default(0)
  // Komisi sopir dianggap "didapat" saat tugas selesai (statusTTD = LENGKAP, bukan draft).
  // komisiDiambil = uang komisinya sudah diserahkan ke sopir.
  komisiDiambil   Boolean   @default(false)
  komisiDiambilAt DateTime?
  createdAt   DateTime @default(now())
  // Dokumen yang dibuat bareng lewat "Jumlah Surat Jalan" > 1 (customer &
  // tujuan sama, cuma nomor SJ beda-beda) berbagi batchId yang sama. Dipakai
  // supaya waktu salah satu di-edit, datanya bisa disamakan ke semua anggota
  // batch itu sekaligus tanpa harus edit satu-satu.
  batchId     String?

  invoiceItems InvoiceItem[]

  @@index([customerId])
  @@index([batchId])
  @@index([sopirId])
}

// "Daftar Kerja Harian" alat berat (di lapangan biasa disebut "Tensiv") --
// rekaman jam kerja sebuah unit alat pada 1 hari, ditandatangani Pengawas &
// Operator di kertas fisik (form "DAFTAR KERJA HARIAN"). Dibuat terpisah dari
// Invoice sama seperti SuratJalan: staf isi rekaman ini dulu tiap hari, baru
// nanti ditarik jadi 1 baris InvoiceItem pas bikin tagihan (lihat tensivId di
// InvoiceItem & endpoint GET /api/tensiv/belum-ditagih), jadi tidak perlu
// ngetik ulang dari kertas langsung ke form invoice.
//
// waktuKerja & waktuTidakKerja disimpan sebagai array JSON karena satu hari
// bisa punya lebih dari 1 baris jam (shift normal + lembur, atau lebih dari
// 1 rentang idle) -- persis bentuk tabel di kertas fisiknya:
//   waktuKerja:      [{ mulai, sampai, totalJam, keterangan }, ...]
//   waktuTidakKerja: [{ mulai, sampai, totalJam }, ...]
// totalJamKerja/totalJamTidakKerja dihitung otomatis di server dari kedua
// array itu (jumlah kolom "Total Jam"), supaya tidak bisa mismatch.
model Tensiv {
  id           String   @id @default(cuid())
  no           String?  @unique // nomor referensi internal opsional, mis. "TS-2609-001"
  divisi       String   @default("Alat Berat")
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  unitAlatId   String?  // opsional: kaitan ke master AlatBeratUnit
  unitAlat     String?  // nama unit dipakai (cache teks, mis. "PC 200", "SANY PC-075")
  typeAlat     String?  // kolom "Type" di kertas fisik, mis. "75"
  kategoriAlat String?  // Bucket/Breker/Longarm/Diatas Air/dst -> dipakai cari rate UangMakanAlat
  pengawas     String?
  lokasi       String?
  tanggal      DateTime
  waktuKerja      Json?  // [{mulai, sampai, totalJam, keterangan}]
  waktuTidakKerja Json?  // [{mulai, sampai, totalJam}]
  totalJamKerja      Float @default(0)
  totalJamTidakKerja Float @default(0)
  keteranganLokasi String?
  namaPengawasTTD  String?
  namaOperatorTTD  String?
  statusTTD    StatusTTD @default(BELUM_TTD)
  isDraft      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  invoiceItems InvoiceItem[]

  @@index([customerId])
  @@index([unitAlatId])
  @@index([tanggal])
}

model DivisiTx {
  id          String   @id @default(cuid())
  divisi      String
  tipe        TipeTransaksi
  // "kelompok" = section pada Laporan Laba Rugi (mis. "Sewa Armada & Excavator",
  // "Pengeluaran Bulanan"), "kategori" = baris/nama item di dalamnya (mis. "Tronton",
  // "Gaji Staff"). Kombinasi kelompok+kategori dijumlah di halaman Laporan Divisi
  // supaya bentuknya persis seperti laporan Excel per divisi.
  kelompok    String   @default("")
  kategori    String   @default("")
  subKategori String?  // opsional, untuk rincian per-kategori (mis. Uang Makan / Sparepart / Solar per unit alat berat)
  keterangan  String?  // catatan tambahan bebas (opsional)
  qty         Float?   // opsional: jumlah (hari, liter, dst) kalau nominal dihitung qty x hargaSatuan
  hargaSatuan Float?   // opsional: harga satuan, dipakai bersama qty
  nominal     Float
  tanggal     DateTime
  sumber      String?  // opsional: asal data, mis. "Excel Import - SUPPLIER (Pengeluaran Juli 2026.xlsx)".
                        // null/kosong = input manual lewat form "Catat Transaksi".
  createdAt   DateTime @default(now())

  @@index([divisi, kelompok, kategori])
}

// Rekapan Stok Solar (BBM) untuk Alat Berat -- mirror dari catatan kertas
// "Stok Solar Masuk" (sopir truk tangki mengantar solar ke lokasi, dicatat
// per nama sopir + jumlah liter) dan "Solar Keluar" (operator alat berat
// mengambil solar untuk unitnya, dicatat per nama operator + jumlah liter +
// lokasi alat beratnya). Saldo stok = total MASUK - total KELUAR, dihitung
// realtime dari data ini (bukan disimpan sebagai angka statis), ditampilkan
// di halaman Laporan Divisi tab "Stok Solar (BBM)".
model SolarTx {
  id         String    @id @default(cuid())
  no         String    @unique // nomor pendek auto-generate, mis. "SM-260902-01" / "SK-260902-01"
  tipe       TipeSolar
  tanggal    DateTime
  nama       String    // nama sopir (MASUK) atau nama operator (KELUAR)
  liter      Float
  lokasi     String?   // hanya untuk KELUAR (lokasi/unit alat berat tujuan solar)
  lokasiLat  Float?    // hasil geocoding otomatis dari `lokasi` (lihat services/geocode.js)
  lokasiLng  Float?    // null kalau lokasi belum ada/gagal digeocode -- tidak wajib diisi
  keterangan String?
  buktiFile  String?   // path file bukti (foto surat jalan / dokumen pendukung), disimpan di /uploads
  buktiNama  String?   // nama file asli saat diupload (untuk ditampilkan)
  divisi     String    @default("Alat Berat")
  createdAt  DateTime  @default(now())

  // Cek keesokan hari -- khusus MASUK. `liter` = stok REAL yang masuk (dipakai
  // untuk saldo); `literCatatan` = angka di buku catatan sopir untuk tanggal
  // tsb. Selisih (liter - literCatatan) dihitung otomatis di solarTx.js.
  // null = catatan buku belum diisi.
  literCatatan Float?

  jadwalSetor SolarJadwalSetor?

  @@index([tipe, tanggal])
}

// Cache hasil geocoding (teks lokasi -> koordinat lat/lng) supaya tidak
// perlu memanggil layanan geocoding (Nominatim/OpenStreetMap) berulang
// kali untuk teks lokasi yang sama -- juga menghormati batas rate limit
// layanan gratis tsb (maks. 1 request/detik). Lihat backend/src/services/geocode.js.
model GeoCache {
  id          String   @id @default(cuid())
  query       String   @unique // teks lokasi yang sudah dinormalisasi (lowercase, trim)
  lat         Float?   // null = pernah dicoba tapi tidak ketemu (supaya tidak dicoba ulang terus)
  lng         Float?
  displayName String?  // nama lengkap hasil dari layanan geocoding, buat referensi/debug
  createdAt   DateTime @default(now())
}

// Checklist harian "Jadwal Setor Solar" -- daftar sopir yang wajib
// menyetorkan sejumlah liter solar pada tanggal tertentu (hasil dari
// sopir yang ambil solar sesuai surat jalan). Diinput manual oleh staff
// tiap hari. Saat direalisasi:
//  - Kalau setornya PAS (literSetor == literWajib) -> tinggal dicentang,
//    status jadi SESUAI, tidak perlu ngetik apa-apa.
//  - Kalau BEDA (kurang/lebih) -> staff ketik jumlah aktual di literSetor,
//    status jadi SELISIH.
// Baik SESUAI maupun SELISIH otomatis bikin 1 baris SolarTx (MASUK) supaya
// nyambung ke saldo Stok Solar yang sudah ada.
// Sopir yang TIDAK ada di jadwal hari itu tapi tetap setor -> tinggal
// ditambah baris baru manual dengan terjadwal=false (tidak perlu fitur
// khusus). Sopir yang setor lebih karena nombok utang solar sebelumnya
// juga tidak perlu ditangani khusus: saldo utang per sopir dihitung
// otomatis dari akumulasi (literWajib - literSetor) seluruh baris yang
// sudah SELISIH/SESUAI (lihat GET /api/solar-jadwal/utang), jadi
// kelebihan setor hari ini otomatis menutup kekurangan hari-hari lalu.
model SolarJadwalSetor {
  id           String      @id @default(cuid())
  tanggal      DateTime    // tanggal wajib setor
  nama         String      // nama sopir
  literWajib   Float
  noSuratJalan String?     // referensi opsional ke no. Surat Jalan
  status       StatusSetor @default(BELUM)
  literSetor   Float?      // diisi saat realisasi (null selama BELUM)
  terjadwal    Boolean     @default(true) // false = ditambah manual/dadakan (nama tidak ada di list awal)
  catatan      String?
  solarTxId    String?     @unique
  solarTx      SolarTx?    @relation(fields: [solarTxId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([tanggal, nama])
}

model PrintCalib {
  id      String @id @default(cuid())
  jenis   String @unique // "sj" atau "inv"
  data    Json
}

// Pengaturan umum aplikasi (key-value), mis. nama penandatangan
// yang tampil di kolom "Hormat kami," pada cetakan Surat Jalan & Invoice.
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
