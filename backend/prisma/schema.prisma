// Skema database untuk Sistem BMS - PT Bintang Muara Sejati
// Menggantikan objek `DB` yang dulu disimpan di window.storage (browser only)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN   // akses semua divisi & pengaturan
  STAFF   // akses terbatas ke divisi miliknya
}

enum StatusPembayaran {
  BELUM
  SEBAGIAN
  LUNAS
}

enum StatusTTD {
  BELUM_TTD
  LENGKAP
}

enum TipeTransaksi {
  PENJUALAN
  PENGELUARAN
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // hash bcrypt
  nama      String
  role      Role     @default(STAFF)
  divisi    String?  // null kalau ADMIN (semua divisi)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  alamat    String?
  telepon   String?
  npwp      String?
  divisi    String
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())

  invoices  Invoice[]
  prices    CustomerPrice[]
  rekapPenjualan RekapPenjualan[]
  suratJalan SuratJalan[]
  recipients CustomerRecipient[]
}

// Daftar "Penerima" pengiriman milik seorang Customer, beserta alamat
// tujuannya masing-masing (kolom "Penerima" & "Tujuan" pada Surat Jalan
// fisik). Dipakai terutama untuk customer distributor yang mengirim ke
// banyak PT/CV berbeda (mis. BP. Alexander -> PT. Pitaco Mitra Perkasa,
// PT. Alko Putra Mahkota, dst) supaya tidak digabung jadi satu alamat
// yang sangat panjang. Untuk customer biasa cukup 1 penerima = nama &
// alamat customer itu sendiri. Data ini bisa ditambah/diedit/dihapus
// bebas lewat menu Customer (kolom Edit).
model CustomerRecipient {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  nama       String   // Nama penerima, mis. "PT. Pitaco Mitra Perkasa"
  alamat     String   // Alamat/tujuan pengiriman penerima ini
  telepon    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Master kode jenis barang/stock (AA = Pasir Putih, BB = Batu Split, dst).
// Dipakai sebagai daftar pilihan (dropdown) saat mengisi harga customer,
// supaya kode tidak diketik manual dan tidak typo/dobel.
model StockMaster {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CustomerPrice {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  destinationCode String
  vehicleType     String   @default("CD") // CD / TRONTON
  stockCode       String
  stockName       String
  hargaM3         Float    @default(0)
  sewaTruk        Float    @default(0)
  hppTruk         Float    @default(0)
  destination     String?
  discount        String?
  createdAt       DateTime @default(now())

  @@unique([customerId, destinationCode, vehicleType, stockCode])
}

model RekapPenjualan {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tanggal       DateTime
  noSuratJalan  String
  noPolisi      String
  jenisBarang   String
  panjang       Float    @default(0)
  lebar         Float    @default(0)
  tinggi        Float    @default(0)
  jumlah        Float    @default(0)
  harga         Float    @default(0)
  total         Float    @default(0)
  catatan       String?
  createdAt     DateTime @default(now())

  @@index([customerId, tanggal])
  @@index([noSuratJalan])
}

model Armada {
  id        String   @id @default(cuid())
  nopol     String
  jenis     String
  sopir     String?
  divisi    String
  // Index P-L-T & Volume (sheet "INDEK MOBIL" di Excel) -- ukuran bak kendaraan,
  // dipakai sebagai acuan/patokan volume muatan (m3) per kendaraan.
  panjang   Float?   // meter
  lebar     Float?   // meter
  tinggi    Float?   // meter
  volume    Float?   // m3, biasanya panjang x lebar x tinggi tapi bisa ditimpa manual
  createdAt DateTime @default(now())

  suratJalan SuratJalan[]
}

model Material {
  id        String   @id @default(cuid())
  nama      String
  satuan    String
  hargaSatuan Float  @default(0)
  divisi    String
  createdAt DateTime @default(now())
}

model Invoice {
  id          String   @id @default(cuid())
  no          String   @unique
  divisi      String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  tanggal     DateTime
  jatuhTempo  DateTime?
  halaman     Int      @default(1)
  status      StatusPembayaran @default(BELUM)
  catatan     String?
  createdAt   DateTime @default(now())

  items       InvoiceItem[]
  pembayaran  Pembayaran[]
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  suratJalanId String?  @unique
  suratJalan   SuratJalan? @relation(fields: [suratJalanId], references: [id])
  keterangan   String
  qty          Float
  satuan       String?
  hargaSatuan  Float
}

model Pembayaran {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tanggal    DateTime
  nominal    Float
  metode     String?
  catatan    String?
}

model SuratJalan {
  id          String   @id @default(cuid())
  no          String   @unique
  divisi      String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  armadaId    String?
  armada      Armada?  @relation(fields: [armadaId], references: [id])
  tujuan      String
  penerima    String?  // Nama penerima (bisa dari master CustomerRecipient, atau diketik/edit manual)
  jenisBarang String?
  noPolisi    String?
  sopir       String?
  panjang     Float    @default(0)
  lebar       Float    @default(0)
  tinggi      Float    @default(0)
  m3          Float    @default(0)
  jam         String?
  tanggal     DateTime
  statusTTD   StatusTTD @default(BELUM_TTD)
  isDraft     Boolean  @default(false)
  detail      Json?    // daftar barang / muatan (fleksibel, mirror bentuk lama)
  createdAt   DateTime @default(now())

  invoiceItems InvoiceItem[]

  @@index([customerId])
}

model DivisiTx {
  id          String   @id @default(cuid())
  divisi      String
  tipe        TipeTransaksi
  // "kelompok" = section pada Laporan Laba Rugi (mis. "Sewa Armada & Excavator",
  // "Pengeluaran Bulanan"), "kategori" = baris/nama item di dalamnya (mis. "Tronton",
  // "Gaji Staff"). Kombinasi kelompok+kategori dijumlah di halaman Laporan Divisi
  // supaya bentuknya persis seperti laporan Excel per divisi.
  kelompok    String   @default("")
  kategori    String   @default("")
  subKategori String?  // opsional, untuk rincian per-kategori (mis. Uang Makan / Sparepart / Solar per unit alat berat)
  keterangan  String?  // catatan tambahan bebas (opsional)
  qty         Float?   // opsional: jumlah (hari, liter, dst) kalau nominal dihitung qty x hargaSatuan
  hargaSatuan Float?   // opsional: harga satuan, dipakai bersama qty
  nominal     Float
  tanggal     DateTime
  sumber      String?  // opsional: asal data, mis. "Excel Import - SUPPLIER (Pengeluaran Juli 2026.xlsx)".
                        // null/kosong = input manual lewat form "Catat Transaksi".
  createdAt   DateTime @default(now())

  @@index([divisi, kelompok, kategori])
}

model PrintCalib {
  id      String @id @default(cuid())
  jenis   String @unique // "sj" atau "inv"
  data    Json
}

// Pengaturan umum aplikasi (key-value), mis. nama penandatangan
// yang tampil di kolom "Hormat kami," pada cetakan Surat Jalan & Invoice.
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
